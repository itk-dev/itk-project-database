<div class="stat-card">
    <div class="stat-card__label">{{ 'dashboard.total'|trans }}</div>
    <div class="stat-card__value">{{ total }}</div>
</div>
<div class="stat-card stat-card--green">
    <div class="stat-card__label">{{ 'dashboard.published'|trans }}</div>
    <div class="stat-card__value">{{ published }}</div>
</div>
<div class="stat-card stat-card--lime">
    <div class="stat-card__label">{{ 'dashboard.drafts'|trans }}</div>
    <div class="stat-card__value">{{ drafts }}</div>
</div>
<div class="stat-card stat-card--accent">
    <div class="stat-card__label">{{ 'nav.contacts'|trans }}</div>
    <div class="stat-card__value">{{ contactCount }}</div>
</div>
