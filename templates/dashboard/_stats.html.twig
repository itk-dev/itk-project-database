<div class="kpi kpi--teal">
    <div class="kpi__label">{{ 'dashboard.total'|trans }}</div>
    <div class="kpi__value" data-live-text="kpi-total" data-count="{{ viz.kpis.total }}">{{ viz.kpis.total }}</div>
    <div class="kpi__hint">{{ 'dashboard.total_hint'|trans }}</div>
</div>
<div class="kpi kpi--green">
    <div class="kpi__label">{{ 'dashboard.in_progress'|trans }}</div>
    <div class="kpi__value" data-live-text="kpi-in-progress" data-count="{{ viz.kpis.inProgress }}">{{ viz.kpis.inProgress }}</div>
    <div class="kpi__hint">{{ 'dashboard.in_progress_hint'|trans }}</div>
</div>
<div class="kpi kpi--cyan">
    <div class="kpi__label">{{ 'dashboard.departments_involved'|trans }}</div>
    <div class="kpi__value" data-live-text="kpi-departments" data-count="{{ viz.kpis.departments }}">{{ viz.kpis.departments }}</div>
    <div class="kpi__hint">{{ 'dashboard.departments_involved_hint'|trans }}</div>
</div>
<div class="kpi kpi--amber">
    <div class="kpi__label">{{ 'dashboard.collaboration_count'|trans }}</div>
    <div class="kpi__value" data-live-text="kpi-collaboration" data-count="{{ viz.kpis.collaboration }}">{{ viz.kpis.collaboration }}</div>
    <div class="kpi__hint">{{ 'dashboard.collaboration_count_hint'|trans }}</div>
</div>
