{% extends 'base.html.twig' %}

{% block title %}{{ 'dashboard.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="page" data-controller="dashboard-live">
        <div class="page__header">
            <div>
                <h1 class="page__title">{{ 'dashboard.title'|trans }}</h1>
                <p class="page__subtitle">{{ 'dashboard.subtitle'|trans }}</p>
            </div>
            <div class="page__actions">
                <a href="{{ path('app_initiative_index') }}" class="btn btn--ghost">{{ 'nav.initiatives'|trans }}</a>
                <a href="{{ path('app_initiative_new') }}" class="btn btn--primary">{{ 'action.new'|trans }}</a>
            </div>
        </div>

        {{ turbo_stream_from('activities') }}

        <div id="dashboard-stats" class="stat-grid">
            {{ include('dashboard/_stats.html.twig') }}
        </div>

        <div class="dashboard-grid">
            <div class="dashboard-col">
                <div class="card">
                    <div class="card__header">
                        <span class="card__title">{{ 'dashboard.recent'|trans }}</span>
                    </div>
                    <div id="dashboard-recent">
                        {{ include('dashboard/_recent.html.twig') }}
                    </div>
                </div>

                <div class="card">
                    <div class="card__header">
                        <span class="card__title">{{ 'dashboard.by_status'|trans }}</span>
                    </div>
                    <div id="dashboard-status" class="status-bars">
                        {{ include('dashboard/_status_bars.html.twig') }}
                    </div>
                </div>
            </div>

            <div class="card card--activity">
                <div class="card__header">
                    <span class="card__title">{{ 'activity.title'|trans }}</span>
                </div>
                <div class="activity-feed-wrap">
                    <div id="activity-feed" class="activity-feed">
                        {% for initiative in recent %}
                            {{ include('activity/_item.html.twig', {
                                id: initiative.id,
                                action: 'updated',
                                title: initiative.title,
                                url: path('app_initiative_show', {id: initiative.id}),
                                actor: initiative.modifiedBy ? initiative.modifiedBy.name : null,
                                at: initiative.updatedAt,
                            }) }}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
