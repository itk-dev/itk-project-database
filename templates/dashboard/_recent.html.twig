{% if recent is empty %}
    <div class="empty-state">
        <div class="empty-state__title">{{ 'dashboard.empty'|trans }}</div>
        <a href="{{ path('app_initiative_new') }}" class="btn btn--primary">{{ 'action.new'|trans }}</a>
    </div>
{% else %}
    <div class="recent-list">
        {% for initiative in recent %}
            <div class="recent-item" data-live-text="recent-{{ initiative.id }}">
                <div>
                    <a href="{{ path('app_initiative_show', {id: initiative.id}) }}" class="recent-item__title">{{ initiative.title }}</a>
                    <div class="recent-item__meta">
                        {%- if initiative.organizationalAnchoring %}{{ initiative.organizationalAnchoring.labelKey|trans }} · {% endif -%}
                        {{ initiative.createdAt|date('d.m.Y') }}
                    </div>
                </div>
                <div class="tag-list">
                    {% if initiative.status %}<span class="badge badge--status-{{ initiative.status.value }}">{{ initiative.status.labelKey|trans }}</span>{% endif %}
                    {% if not initiative.published %}<span class="badge badge--draft">{{ 'filter.draft'|trans }}</span>{% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endif %}
