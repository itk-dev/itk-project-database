{{ form_start(form, {attr: {class: 'form'}}) }}
    {{ form_errors(form) }}

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.basics'|trans }}</div>
        {{ form_row(form.title) }}
        <div class="form-grid">
            {{ form_row(form.category) }}
            {{ form_row(form.initiativeType) }}
        </div>
        {{ form_row(form.description) }}
    </div>

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.classification'|trans }}</div>
        <div class="form-grid">
            {{ form_row(form.status) }}
            {{ form_row(form.organizationalAnchoring) }}
        </div>
        {{ form_row(form.statusAdditional) }}
        {{ form_row(form.strategies) }}
        {{ form_row(form.tags) }}
    </div>

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.endorsement'|trans }}</div>
        {{ form_row(form.endorsement) }}
        {{ form_row(form.endorsementAuthor) }}
    </div>

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.economy'|trans }}</div>
        <div class="form-grid">
            {{ form_row(form.budget) }}
            {{ form_row(form.timePeriodStart) }}
            {{ form_row(form.timePeriodEnd) }}
        </div>
        {{ form_row(form.funding) }}

        <div class="form-row">
            <label>{{ 'initiative.links'|trans }}</label>
            <div class="collection" data-collection data-remove-label="{{ 'action.remove'|trans }}"
                 data-prototype="{{ form_widget(form.links.vars.prototype)|e('html_attr') }}">
                <div class="collection" data-collection-list>
                    {% for link in form.links %}
                        <div class="collection__item" data-collection-item>
                            {{ form_widget(link) }}
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn--ghost btn--sm" data-collection-add>{{ 'action.add_link'|trans }}</button>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.relations'|trans }}</div>
        {{ form_row(form.stakeholders) }}

        <div class="form-row">
            <label>{{ 'initiative.contacts'|trans }}</label>
            <div class="collection" data-collection data-remove-label="{{ 'action.remove'|trans }}"
                 data-prototype="{{ form_widget(form.contacts.vars.prototype)|e('html_attr') }}">
                <div class="collection" data-collection-list>
                    {% for contact in form.contacts %}
                        <div class="collection__item" data-collection-item>
                            <div class="collection__fields form-grid">
                                {{ form_widget(contact) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn--ghost btn--sm" data-collection-add>{{ 'action.add_contact'|trans }}</button>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.media'|trans }}</div>

        <div class="form-row">
            <label>{{ 'initiative.images'|trans }}</label>
            <div class="collection" data-collection data-remove-label="{{ 'action.remove'|trans }}"
                 data-prototype="{{ form_widget(form.images.vars.prototype)|e('html_attr') }}">
                <div class="collection" data-collection-list>
                    {% for image in form.images %}
                        <div class="collection__item" data-collection-item>
                            <div class="collection__fields">
                                {% if image.vars.value and image.vars.value.id and image.vars.value.imageName %}
                                    <a href="{{ path('app_media_image', {id: image.vars.value.id}) }}" target="_blank" rel="noopener">{{ image.vars.value.originalName ?: 'image' }}</a>
                                {% endif %}
                                {{ form_widget(image) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn--ghost btn--sm" data-collection-add>{{ 'action.add_image'|trans }}</button>
            </div>
        </div>

        <div class="form-row">
            <label>{{ 'initiative.attachments'|trans }}</label>
            <div class="collection" data-collection data-remove-label="{{ 'action.remove'|trans }}"
                 data-prototype="{{ form_widget(form.attachments.vars.prototype)|e('html_attr') }}">
                <div class="collection" data-collection-list>
                    {% for attachment in form.attachments %}
                        <div class="collection__item" data-collection-item>
                            <div class="collection__fields">
                                {% if attachment.vars.value and attachment.vars.value.id and attachment.vars.value.fileName %}
                                    <a href="{{ path('app_media_attachment', {id: attachment.vars.value.id}) }}" target="_blank" rel="noopener">{{ attachment.vars.value.originalName ?: 'file' }}</a>
                                {% endif %}
                                {{ form_widget(attachment) }}
                            </div>
                        </div>
                    {% endfor %}
                </div>
                <button type="button" class="btn btn--ghost btn--sm" data-collection-add>{{ 'action.add_attachment'|trans }}</button>
            </div>
        </div>
    </div>

    <div class="form-section">
        <div class="form-section__title">{{ 'initiative.section.meta'|trans }}</div>
        {{ form_row(form.author) }}
        {{ form_row(form.published) }}
    </div>

    <div class="form-actions">
        <button type="submit" class="btn btn--primary">{{ button_label|default('action.save')|trans }}</button>
        <a href="{{ initiative.id ? path('app_initiative_show', {id: initiative.id}) : path('app_initiative_index') }}" class="btn btn--ghost">{{ 'action.cancel'|trans }}</a>
    </div>
{{ form_end(form) }}
