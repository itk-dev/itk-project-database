{% extends 'base.html.twig' %}

{% block title %}{{ 'initiative.new.title'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block body %}
    <div class="page" data-controller="title-mirror" data-action="autosave:created->title-mirror#linkCrumb">
        <div class="page__header">
            <div>
                <div class="breadcrumb">
                    <a href="{{ path('app_initiative_index') }}">{{ 'nav.initiatives'|trans }}</a>
                    / <span data-title-mirror-target="crumb">{{ 'initiative.new.title'|trans }}</span>
                </div>
                <h1 class="page__title" data-title-mirror-target="heading">{{ 'initiative.new.title'|trans }}</h1>
            </div>
        </div>
        {{ include('initiative/_form.html.twig', {button_label: 'action.create', autosave: true}) }}
    </div>
{% endblock %}
