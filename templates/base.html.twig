<!DOCTYPE html>
<html lang="{{ app.request.locale }}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{{ 'app.name'|trans }}{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 32 32%22><rect width=%2232%22 height=%2232%22 rx=%226%22 fill=%22%23007ba6%22/></svg>">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
    {% block nav %}
        {% if app.user %}
            {% set route = app.request.attributes.get('_route') %}
            <nav class="top-nav">
                <a href="{{ path('app_dashboard') }}" class="top-nav__brand">
                    <span class="top-nav__brand-mark"></span>
                    <span>{{ 'app.name'|trans }}</span>
                </a>
                <div class="top-nav__menu">
                    <a href="{{ path('app_dashboard') }}" class="top-nav__link {{ route == 'app_dashboard' ? 'is-active' }}">{{ 'nav.dashboard'|trans }}</a>
                    <a href="{{ path('app_initiative_index') }}" class="top-nav__link {{ route starts with 'app_initiative' ? 'is-active' }}">{{ 'nav.initiatives'|trans }}</a>
                    <a href="{{ path('app_contact_index') }}" class="top-nav__link {{ route starts with 'app_contact' ? 'is-active' }}">{{ 'nav.contacts'|trans }}</a>
                </div>
                <div class="top-nav__right">
                    <div class="top-nav__menu-anchor">
                        <button type="button" id="userMenuToggle" class="user-menu__toggle">
                            <span>{{ app.user.name }}</span>
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
                        </button>
                        <div id="userMenu" class="user-menu">
                            <div class="user-menu__header">
                                <div class="user-menu__eyebrow">{{ 'nav.signed_in_as'|trans }}</div>
                                <div class="user-menu__name">{{ app.user.name }}</div>
                                <div class="user-menu__email">{{ app.user.email }}</div>
                            </div>
                            <div class="user-menu__section">
                                <div class="user-menu__eyebrow">{{ 'nav.language'|trans }}</div>
                                <div class="lang-toggle">
                                    <a href="{{ path('app_locale', {locale: 'da', return: app.request.requestUri}) }}" class="lang-toggle__option {{ app.request.locale == 'da' ? 'lang-toggle__option--active' }}">DA</a>
                                    <a href="{{ path('app_locale', {locale: 'en', return: app.request.requestUri}) }}" class="lang-toggle__option {{ app.request.locale == 'en' ? 'lang-toggle__option--active' }}">EN</a>
                                </div>
                            </div>
                            {% if is_granted('ROLE_ADMIN') %}
                                <a href="{{ path('admin_users') }}" class="user-menu__link">{{ 'nav.admin'|trans }}</a>
                            {% endif %}
                            <a href="{{ path('app_logout') }}" class="user-menu__logout">{{ 'nav.logout'|trans }}</a>
                        </div>
                    </div>
                </div>
            </nav>
        {% endif %}
    {% endblock %}

    {% block body %}{% endblock %}

    {% block flashes %}
        {% set all_flashes = app.flashes %}
        {% if all_flashes|length > 0 %}
            <div class="flash-messages">
                {% for type, messages in all_flashes %}
                    {% for message in messages %}
                        <div class="flash flash--{{ type == 'success' ? 'success' : 'error' }}">{{ message|trans }}</div>
                    {% endfor %}
                {% endfor %}
            </div>
        {% endif %}
    {% endblock %}
</body>
</html>
