{% set count = initiatives|length %}
<twig:ConfirmDelete
    :action="path('admin_partner_delete', {id: partner.id})"
    :token="csrf_token('delete-partner-' ~ partner.id)"
    :title="'action.confirm_delete_title'|trans({'%name%': partner.name})"
    :triggerClass="'btn btn--danger' ~ (small|default(false) ? ' btn--sm' : '')"
    :confirmLabel="count > 0 ? 'partner.delete.confirm'|trans : null"
>
    {% if count > 0 %}
        <p>{{ 'partner.delete.in_use'|trans({'%count%': count}) }}</p>
        <ul class="confirm__list">
            {% for initiative in initiatives %}
                <li><a href="{{ path('app_initiative_show', {id: initiative.id}) }}" target="_blank" rel="noopener">{{ initiative.title }}</a></li>
            {% endfor %}
        </ul>
        <p class="confirm__warning">{{ 'partner.delete.consequence'|trans }}</p>
    {% else %}
        <p>{{ 'partner.delete.unused'|trans }}</p>
    {% endif %}
</twig:ConfirmDelete>
