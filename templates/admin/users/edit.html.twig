{% extends 'admin/base.html.twig' %}

{% block title %}{{ 'admin.users.edit'|trans }} · {{ 'app.name'|trans }}{% endblock %}

{% block admin_content %}
    <twig:Page:Header :title="user.email" style="margin-bottom: var(--itk-space-5);">
        {% if user.id != app.user.id %}
            <twig:ConfirmDelete
                :action="path('admin_user_delete', {id: user.id})"
                :token="csrf_token('delete-user-' ~ user.id)"
                :title="'action.confirm_delete_title'|trans({'%name%': user.email})" />
        {% endif %}
    </twig:Page:Header>

    {{ form_start(form, {attr: {class: 'form'}}) }}
        <div class="form-section">
            {{ form_errors(form) }}
            {{ form_row(form.email) }}
            {{ form_row(form.name) }}
            {{ form_row(form.roles) }}
            {{ form_row(form.plainPassword) }}
        </div>
        <div class="form-actions">
            <button type="submit" class="btn btn--primary">{{ 'action.save'|trans }}</button>
            <a href="{{ path('admin_users') }}" class="btn btn--ghost">{{ 'action.cancel'|trans }}</a>
        </div>
    {{ form_end(form) }}
{% endblock %}
