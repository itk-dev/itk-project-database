        <div class="page__header">
            <div>
                <div class="breadcrumb"><a href="{{ path('app_contact_index') }}">{{ 'nav.contacts'|trans }}</a></div>
                <h1 class="page__title">{{ 'contact.new.title'|trans }}</h1>
            </div>
        </div>
        {{ include('contact/_form.html.twig', {button_label: 'action.create'}) }}
    </div>
{% endblock %}
